# DocuForge Environment Configuration Template
# Copy this file to .env.local to configure your environment

# Canonical Website URL
NEXT_PUBLIC_SITE_URL=https://docuforge.app

# Google AdSense Configuration
# Replace with your actual publisher ID once approved by Google AdSense (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Toggle commercial ad units (keep false until AdSense approval is granted)
NEXT_PUBLIC_ENABLE_ADS=false
