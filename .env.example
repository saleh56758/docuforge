# DocuForge Environment Configuration Template
# Copy this file to .env.local to configure your environment

# Canonical Website URL
NEXT_PUBLIC_SITE_URL=https://docuforge.pages.dev

# Optional Google Search Console HTML-tag verification token.
# Paste only the token value Google provides (not the complete <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Web3Forms contact form access key (publicly exposed to the browser at build time).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# AdSense is disabled in the application until approval and ad-unit configuration are confirmed.
# The client reads this publisher ID for the AdSense data-ad-client attribute.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
